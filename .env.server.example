# Copie como .env.server.local; mantenha os valores privados.
# Configure as mesmas variáveis na Vercel (Settings > Environment Variables).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
EFATA_ADMIN_KEY=
# Endereço HTTPS do site, sem barra final; múltiplos endereços separados por vírgula.
# Na Vercel, os domínios padrão do projeto também são detectados automaticamente.
EFATA_ALLOWED_ORIGINS=https://tradutor-libras.vercel.app
